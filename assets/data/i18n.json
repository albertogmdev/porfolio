  "about.title": {
    "es": "Sobre mí",
    "en": "About me"
  },
  "about.p1": {
    "es": "He estado trabajando como **Full-Stack Developer** en diversos proyectos web, e-commerces y landing pages, para diferentes clientes, usando numerosas tecnologías y lenguajes de programación.",
    "en": "I have been working as a **Full-Stack Developer** on a wide range of web projects, e-commerce sites and landing pages for different clients, using many technologies and programming languages."
  },
  "about.p2": {
    "es": "En el front trabajo con **HTML, CSS, SASS y JavaScript**, y con frameworks como ReactJS, VueJS, NextJS, NuxtJS y Astro. En el back, con PHP y CodeIgniter, bases de datos MySQL, PostgreSQL y MongoDB.",
    "en": "On the front end I work with **HTML, CSS, SASS and JavaScript**, and with frameworks such as ReactJS, VueJS, NextJS, NuxtJS and Astro. On the back end, with PHP and CodeIgniter, and MySQL, PostgreSQL and MongoDB databases."
  },
  "about.p3": {
    "es": "Tengo experiencia con **Shopify** y CMS como WordPress, Storyblok, Sitecore, Strapi o Sanity, con servicios de **AWS** como S3, Route53, Lambda y Cloud9, y con control de versiones en GitHub y bash/shell.",
    "en": "I have experience with **Shopify** and CMSs such as WordPress, Storyblok, Sitecore, Strapi or Sanity, with **AWS** services such as S3, Route53, Lambda and Cloud9, and with version control on GitHub and bash/shell."
  },
